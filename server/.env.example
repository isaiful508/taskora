DATABASE_URL="postgresql://postgres:password@localhost:5432/taskora?schema=public"
# Runtime PostgreSQL URL; use the provider's pooled URL on serverless platforms when available.
# Optional direct PostgreSQL URL for Prisma migrations; defaults to DATABASE_URL when unset.
# DIRECT_URL="postgresql://user:password@localhost:5432/taskora?schema=public"
PORT=4000
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="7d"
CORS_ORIGIN="http://localhost:3000"
NODE_ENV=development
MENTOR_EMAIL="mentor@example.com"
MENTOR_PASSWORD="replace-with-a-unique-password-of-12-characters-or-more"
STUDENT_DEMO_PASSWORD="replace-with-a-different-unique-password"
# ISO-8601 timestamp with timezone; leave unset for no deadline.
# SUBMISSION_DEADLINE=2026-12-31T23:59:59+06:00
ALLOW_LATE_SUBMISSIONS=true
